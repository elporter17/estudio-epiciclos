# Copia este archivo como .env y pon tus valores. El .env nunca se sube a GitHub.
# Sandbox "circularte-dev" en developers.tiktok.com > Circularte > Sandbox > Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://circularte.edav-tech.com/tiktok-callback.html
# Para las descripciones con IA (OpenAI). También sirve OPENAI_API_KEY.
OPEN_AI=
# Modelo opcional (por defecto gpt-6-luna)
# CIRCULARTE_CAPTION_MODEL=
# Opcional: el mismo valor del secreto STATE_KEY de GitHub (scripts/secrets-to-clipboard.ps1 lo copia de aquí)
# STATE_KEY=<cadena aleatoria larga>
# Solo para la web en Vercel (Settings > Environment Variables), no hacen falta en local:
# SESSION_SECRET=<cadena aleatoria larga>
# BLOB_READ_WRITE_TOKEN la crea Vercel al conectar el almacén Blob
