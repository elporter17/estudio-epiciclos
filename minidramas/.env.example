# Copia este archivo como .env y pon tus valores. El .env nunca se sube a GitHub.

# OpenAI (guion, voz, transcripción e imágenes). También sirve OPENAI_API_KEY.
OPEN_AI=

# Modelos opcionales (estos son los valores por defecto)
# MINIDRAMAS_SCRIPT_MODEL=gpt-6-sol
# MINIDRAMAS_TTS_MODEL=gpt-4o-mini-tts
# MINIDRAMAS_TRANSCRIBE_MODEL=whisper-1
# MINIDRAMAS_IMAGE_MODEL=gpt-image-2.5-flare
# MINIDRAMAS_IMAGE_SIZE=1088x1920
# MINIDRAMAS_IMAGE_QUALITY=medium

# TikTok: la misma app que CirculArte (developers.tiktok.com > Circularte > Sandbox "circularte-dev" > Credentials)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://circularte.edav-tech.com/tiktok-callback.html

# Token compartido con CirculArte: un solo archivo para las dos herramientas (se renueva en su sitio).
# Si lo dejas vacío, se usa data/tiktok-token.json de este repo y tendrás que ejecutar «npm run tiktok:connect».
TIKTOK_TOKEN_FILE=../estudio-epiciclos/data/tiktok-token.json
